---
// Fontit tarjoillaan sivuston omina tiedostoina (ei Google Fonts -latausta).
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="fi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Brändivärit (logo: navy, kupari, kiven siniharmaat; mustavalkoiset versiot) */
		--navy: #1c3453;
		--navy-2: #243f66;
		--blue: #3a5a85;
		--blue-soft: #e3e8ef;
		--orange: #c8764b;
		--orange-dark: #a0522f; /* tekstikäyttöön, riittävä kontrasti */
		--orange-soft: #f7e6dc;
		--surface: #ffffff;
		--surface-2: #f2f4f7;
		--white: #ffffff;
		--ink: #111a26;
		--muted: #4b5a6e;
		--line: #dde2e9;
		--black: #0a0b0d; /* valkoinen logo mustalla pohjalla */
		--black-2: #15181d;
		--on-dark: #e9edf2;
		--on-dark-accent: #eba27a;
		--copper-gradient: linear-gradient(90deg, #a0522f, #e79664 45%, #c8764b 75%, #a0522f);
		--facets-dark: url('/brand/facets-dark.svg');

		--radius: 14px;
		--shadow: 0 10px 30px -12px rgba(28, 52, 83, 0.25);
		--max: 1160px;
		--font-head: 'Montserrat', system-ui, sans-serif;
		--font-body: 'Inter', system-ui, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 108px;
	}

	body {
		margin: 0;
		background: var(--surface);
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 17px;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-head);
		color: var(--navy);
		line-height: 1.2;
		margin: 0 0 0.5em;
	}

	h2 {
		font-size: clamp(1.75rem, 3.2vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	h3 {
		font-size: 1.2rem;
		font-weight: 700;
	}

	p {
		margin: 0 0 1em;
	}

	a {
		color: var(--blue);
	}

	img,
	svg {
		max-width: 100%;
		display: block;
	}

	.container {
		width: 100%;
		max-width: var(--max);
		margin: 0 auto;
		padding: 0 24px;
	}

	.section {
		padding: 96px 0;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--orange-dark);
		margin-bottom: 12px;
	}

	.lead {
		font-size: 1.15rem;
		color: var(--muted);
		max-width: 680px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 14px 26px;
		border-radius: 999px;
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 0.98rem;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
		border: 2px solid transparent;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn:focus-visible,
	a:focus-visible {
		outline: 3px solid var(--orange);
		outline-offset: 3px;
	}

	.btn-primary {
		background: var(--orange-dark);
		color: var(--white);
		box-shadow: 0 8px 20px -8px rgba(160, 82, 47, 0.6);
	}

	.btn-primary:hover {
		background: #874425;
	}

	.btn-secondary {
		background: transparent;
		color: var(--navy);
		border-color: var(--navy);
	}

	.btn-secondary:hover {
		background: var(--navy);
		color: var(--white);
	}

	.btn-light {
		background: var(--white);
		color: var(--navy);
	}

	/* Tumma brändipinta: valkoinen mustalla, logon kivipinta tekstuurina */
	.surface-dark {
		position: relative;
		overflow: hidden;
		background: var(--facets-dark) center / 480px auto, var(--black);
		color: var(--on-dark);
	}
	.surface-dark > .container {
		position: relative;
		z-index: 1;
	}
	/* Valkoinen halkeama koristekuvana tumman pinnan taustalla */
	.surface-dark > svg.hero-mark {
		position: absolute;
		right: -3%;
		top: 46%;
		width: min(520px, 36%);
		opacity: 0.16;
		pointer-events: none;
	}
	@media (max-width: 1100px) {
		.surface-dark > svg.hero-mark {
			display: none;
		}
	}

	@media (max-width: 720px) {
		body {
			font-size: 16px;
		}
		.section {
			padding: 64px 0;
		}
		.container {
			padding: 0 16px;
		}
	}

	/* Tulostus: musta logo valkoisella pohjalla, tummat pinnat vaaleiksi */
	@media print {
		.site-header {
			position: static !important;
		}
		.main-nav,
		.header-actions,
		.surface-dark > svg.hero-mark {
			display: none !important;
		}
		.brand img,
		.footer-logo {
			content: url('/aivanto-logo-black.png');
		}
		.surface-dark,
		.site-footer {
			background: #ffffff !important;
			color: #0a0b0d !important;
		}
		.surface-dark :is(h1, h2, h3, p, a, span),
		.site-footer :is(p, a) {
			color: #0a0b0d !important;
		}
		.crack-white polygon {
			fill: #0a0b0d;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		* {
			transition: none !important;
			animation: none !important;
		}
	}
</style>
