---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formUrl =
	'https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=ZZIEfFlONEqw1ZdaDy-jybmXyPQC58dNivWb--XntDBURUxBSURLMEdXSkZKS0o5U1pJU1IyTTNXTyQlQCN0PWcu';

const contact = {
	phone: '044 592 3414',
	phoneHref: '+358445923414',
};
---

<Layout
	title="Ota yhteyttä | AI Strategy Blueprint | AIvanTO Oy"
	description="Ota yhteyttä AIvanTOon – kerro organisaatiosi tilanteesta, niin ehdotamme sopivan AI Strategy Blueprint -paketin ja aikataulun."
>
	<Header />

	<main>
		<section class="contact-hero">
			<div class="container">
				<a href={`${base}/`} class="back">← Takaisin etusivulle</a>
				<span class="eyebrow eyebrow-light">Ota yhteyttä</span>
				<h1>Aloitetaan tekoälystrategiasi rakentaminen</h1>
				<p class="lead-light">
					Kerro organisaatiosi tilanteesta lomakkeella, niin ehdotamme sopivan paketin ja aikataulun.
				</p>
			</div>
		</section>

		<section class="form-section">
			<div class="container form-grid">
				<div class="form-card">
					<iframe
						src={`${formUrl}&embed=true`}
						title="Yhteydenottolomake"
						allowfullscreen></iframe>
					<p class="form-fallback">
						Eikö lomake näy? <a href={formUrl} target="_blank" rel="noopener">Avaa lomake uuteen ikkunaan</a>.
						Lue, miten käsittelemme tietojasi: <a href={`${base}/tietosuoja/`}>tietosuojaseloste</a>.
					</p>
				</div>

				<aside class="side-card">
					<h2>Soita suoraan</h2>
					<p class="contact-name">Marko Määttä<span>AIvanTO Oy</span></p>
					<a class="contact-line" href={`tel:${contact.phoneHref}`}>
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"></path></svg>
						{contact.phone}
					</a>
					<hr />
					<h3>Mitä tapahtuu seuraavaksi?</h3>
					<ol class="next-steps">
						<li>Käymme viestisi läpi.</li>
						<li>Olemme yhteydessä ja sovimme lyhyen keskustelun.</li>
						<li>Ehdotamme sopivan paketin ja aikataulun.</li>
					</ol>
				</aside>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.contact-hero {
		background: var(--navy);
		color: #e8eff5;
		padding: 56px 0 120px;
	}
	.contact-hero h1 {
		color: var(--white);
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 800;
		max-width: 760px;
	}
	.eyebrow-light {
		color: #f0b286;
	}
	.back {
		display: table;
		color: #e8eff5;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		margin-bottom: 28px;
	}
	.back:hover {
		color: #f0b286;
	}
	.lead-light {
		font-size: 1.15rem;
		max-width: 620px;
		margin: 0;
	}
	.form-section {
		padding: 0 0 96px;
		margin-top: -72px;
	}
	.form-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 24px;
		align-items: start;
	}
	.form-card,
	.side-card {
		background: var(--white);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.form-card {
		padding: 12px;
		border-top: 5px solid var(--orange);
	}
	.form-card iframe {
		display: block;
		width: 100%;
		height: 900px;
		border: 0;
		border-radius: 8px;
	}
	.form-fallback {
		margin: 12px 12px 4px;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.side-card {
		padding: 32px;
	}
	.side-card h2 {
		font-size: 1.3rem;
	}
	.contact-name {
		font-family: var(--font-head);
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--navy);
		margin: 0 0 12px;
		display: flex;
		flex-direction: column;
	}
	.contact-name span {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.contact-line {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--navy);
		text-decoration: none;
		font-weight: 600;
	}
	.contact-line:hover {
		color: var(--orange-dark);
	}
	.contact-line svg {
		flex: none;
		color: var(--blue);
	}
	hr {
		border: 0;
		border-top: 1px solid var(--line);
		margin: 24px 0;
	}
	.side-card h3 {
		font-size: 1.05rem;
	}
	.next-steps {
		margin: 0;
		padding-left: 20px;
		color: var(--muted);
		display: grid;
		gap: 8px;
	}
	@media (max-width: 900px) {
		.form-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 600px) {
		.contact-hero {
			padding: 40px 0 96px;
		}
		.form-card {
			padding: 6px;
		}
		.form-card iframe {
			height: 1000px;
		}
		.side-card {
			padding: 24px;
		}
	}
</style>
