---
import Layout from '../layouts/Layout.astro';
import Crack from '../components/Crack.astro';
import HeroVisual from '../components/HeroVisual.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import JourneySteps from '../components/JourneySteps.astro';
import { contactPage, getServices, serviceUrl } from '../lib/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = await getServices();
const entryService = services.find((s) => s.data.slug === 'ai-lahtopiste') ?? services[0];
---

<Layout
	title="AIvanTO Oy | Tekoäly osaksi yrityksenne arkea"
	description="AIvanTOn palvelut AI-lähtöpisteestä tiekarttaan, tekoälyvaatimuksiin, käytännön toteutuksiin ja osaamisen kehittämiseen. Rajatut palvelut kiinteillä tai porrastetuilla hinnoilla."
>
	<Header />

	<main id="top">
		<!-- HERO -->
		<section class="hero">
			<div class="container hero-grid">
				<div class="hero-copy">
					<span class="eyebrow">AIvanTO Oy</span>
					<h1>Tekoäly osaksi <span>yrityksenne arkea</span></h1>
					<p class="hero-sub">Rajatut palvelut, selkeät hinnat ja konkreettiset lopputulokset.</p>
					<p class="lead">
						Suunnittelemme ja toteutamme ratkaisuja, jotka säästävät aikaa, tukevat päätöksentekoa ja vauhdittavat
						kasvua. Palvelumme muodostavat selkeän polun AI-lähtöpisteestä tiekarttaan, vaatimusten
						huomioimiseen, käytännön toteutuksiin ja osaamisen kehittämiseen.
					</p>
					<div class="hero-actions">
						<a href="#palvelut" class="btn btn-primary">Tutustu palveluihin <span aria-hidden="true">→</span></a>
						<a href={serviceUrl(entryService)} class="btn btn-secondary">Aloita AI-lähtöpisteestä</a>
					</div>
					<ul class="hero-facts">
						<li><strong>{services.length}</strong><span>palvelua</span></li>
						<li><strong>alkaen 400 €</strong><span>alv 0 %</span></li>
						<li><strong>Kiinteä tai porrastettu</strong><span>hinnoittelu</span></li>
					</ul>
				</div>
				<div class="hero-art">
					<HeroVisual />
				</div>
			</div>
			<Crack class="hero-crack" />
		</section>

		<!-- PALVELUT -->
		<section id="palvelut" class="section section-alt">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Palvelut</span>
					<h2>Tuotteet ja palvelut</h2>
					<p class="lead">
						Jokainen palvelu on rajattu, kiinteästi tai porrastetusti hinnoiteltu ja tuottaa konkreettisen
						lopputuloksen. Kaikki hinnat alv 0 %.
					</p>
				</div>
				<ServiceGrid services={services} />
				<p class="more-link">
					<a href={`${base}/palvelut/#hinnat`} class="btn btn-secondary">Katso hintataulukko</a>
				</p>
			</div>
		</section>

		<!-- MITEN ETENEMME -->
		<section id="miten-etenemme" class="section">
			<div class="container">
				<div class="section-head">
					<h2>Miten etenemme</h2>
					<p class="lead">Lähtöpisteestä tuloksiin, askel kerrallaan.</p>
				</div>
				<JourneySteps services={services} />
			</div>
		</section>

		<!-- YHTEYS -->
		<section id="yhteys" class="section contact">
			<div class="container contact-grid">
				<div>
					<span class="eyebrow eyebrow-light">Ota yhteyttä</span>
					<h2>Aloitetaan tekoälyn hyödyntäminen</h2>
					<p class="contact-lead">
						Kertokaa organisaationne tilanteesta, niin ehdotamme sopivan palvelun ja aikataulun.
					</p>
				</div>
				<a href={contactPage} class="contact-card">
					<svg class="form-art" viewBox="0 0 240 150" aria-hidden="true">
						<!-- Lomakearkki -->
						<rect x="36" y="14" width="120" height="126" rx="10" fill="#ffffff" stroke="#dcd3c4"></rect>
						<rect x="52" y="32" width="56" height="6" rx="3" fill="#0e2a47"></rect>
						<rect x="52" y="50" width="88" height="14" rx="4" fill="#dce8f0"></rect>
						<rect x="52" y="72" width="88" height="14" rx="4" fill="#dce8f0"></rect>
						<rect x="52" y="94" width="88" height="24" rx="4" fill="#dce8f0"></rect>
						<rect x="52" y="124" width="40" height="8" rx="4" fill="#a8531d"></rect>
						<!-- Paperilennokki -->
						<path d="M150 70 L222 40 L196 112 L178 88 Z" fill="#c8733a"></path>
						<path d="M178 88 L222 40 L186 96 Z" fill="#a8531d"></path>
						<path d="M178 88 L184 108 L190 97 Z" fill="#0e2a47"></path>
						<path d="M120 118 C 132 100, 140 96, 150 90" fill="none" stroke="#2f6a8f" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round"></path>
					</svg>
					<h3>Täytä yhteydenottolomake</h3>
					<ul class="contact-points">
						<li>Täyttäminen vie noin 1–2 minuuttia</li>
						<li>Otamme yhteyttä mahdollisimman pian</li>
					</ul>
					<span class="btn btn-primary">Siirry lomakkeelle <span aria-hidden="true">→</span></span>
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	/* Hero */
	.hero {
		position: relative;
		padding: 72px 0 0;
		background:
			radial-gradient(900px 400px at 85% 20%, rgba(47, 106, 143, 0.12), transparent 70%),
			radial-gradient(600px 300px at 10% 90%, rgba(200, 115, 58, 0.1), transparent 70%);
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 56px;
		align-items: center;
		padding-bottom: 56px;
	}
	.hero h1 {
		font-size: clamp(2.3rem, 5.4vw, 3.8rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		margin-bottom: 12px;
	}
	.hero h1 span {
		color: var(--blue);
	}
	.hero-sub {
		font-family: var(--font-head);
		font-weight: 700;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		color: var(--orange-dark);
		margin-bottom: 16px;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin: 28px 0 36px;
	}
	.hero-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.hero-facts li {
		display: flex;
		flex-direction: column;
		border-left: 3px solid var(--orange);
		padding-left: 14px;
	}
	.hero-facts strong {
		font-family: var(--font-head);
		font-size: 1.35rem;
		color: var(--navy);
	}
	.hero-facts span {
		font-size: 0.9rem;
		color: var(--muted);
	}
	.hero-crack {
		display: block;
	}

	/* Palvelut */
	.section-alt {
		background: var(--cream-2);
	}
	.section-head {
		margin-bottom: 44px;
	}
	.more-link {
		margin: 40px 0 0;
		text-align: center;
	}

	/* Yhteys */
	.contact {
		background: var(--navy);
		color: #e8eff5;
	}
	.contact h2 {
		color: var(--white);
	}
	.eyebrow-light {
		color: #f0b286;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		align-items: center;
	}
	.contact-lead {
		font-size: 1.15rem;
		max-width: 520px;
	}
	.contact-card {
		display: grid;
		gap: 14px;
		background: var(--cream);
		color: var(--ink);
		border-radius: var(--radius);
		padding: 32px 36px 36px;
		border-top: 5px solid var(--orange);
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.contact-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 24px 40px -18px rgba(0, 0, 0, 0.5);
	}
	.contact-card:hover .btn {
		background: #8f4415;
	}
	.form-art {
		width: 100%;
		max-width: 260px;
		height: auto;
		margin: 0 auto 4px;
	}
	.contact-card h3 {
		font-size: 1.35rem;
		margin: 0;
	}
	.contact-points {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 8px;
		color: var(--muted);
	}
	.contact-points li {
		position: relative;
		padding-left: 26px;
	}
	.contact-points li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 6px;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--blue-soft);
		box-shadow: inset 0 0 0 4px var(--blue);
	}
	.contact-card .btn {
		justify-content: center;
		margin-top: 10px;
	}

	/* Responsiivisuus */
	.hero-grid > *,
	.contact-grid > * {
		min-width: 0;
	}
	@media (max-width: 900px) {
		.hero-grid,
		.contact-grid {
			grid-template-columns: 1fr;
		}
		.hero-grid {
			gap: 40px;
		}
		.hero-art {
			max-width: 520px;
		}
	}
	@media (max-width: 600px) {
		.hero {
			padding-top: 44px;
		}
		.contact-card {
			padding: 24px;
		}
		.hero-facts {
			gap: 20px;
		}
	}
</style>
