---
import Layout from '../layouts/Layout.astro';
import Crack from '../components/Crack.astro';
import HeroVisual from '../components/HeroVisual.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/aivanto-logo.jpg`;

const contact = {
	email: 'marko.maatta@aivanto.fi',
	phone: '044 592 3414',
	phoneHref: '+358445923414',
	company: 'AIvanTO Oy',
	businessId: '3610409-8',
};

const gaps = [
	{ title: 'Yhteinen suunta', text: 'Mihin tekoälyllä tähdätään ja miksi – visio, joka ohjaa päätöksiä.' },
	{ title: 'Prioriteetit', text: 'Mitkä käyttötapaukset tuovat eniten arvoa pienimmällä riskillä.' },
	{ title: 'Pelisäännöt', text: 'Governance, tietoturva ja vastuut, joiden varassa käyttö on hallittua.' },
	{ title: 'Etenemissuunnitelma', text: 'Konkreettiset seuraavat askeleet ja vaiheistettu roadmap.' },
];

const includes = [
	{ icon: 'survey', text: 'Kattava, organisaation kokoon mukautuva kysely' },
	{ icon: 'gauge', text: 'AI-nykytilan ja kypsyyden analyysi' },
	{ icon: 'target', text: 'AI-visio ja strategiset tavoitteet' },
	{ icon: 'grid', text: 'Priorisoidut käyttötapaukset' },
	{ icon: 'shield', text: 'Governance-, tietoturva- ja riskisuositukset' },
	{ icon: 'route', text: '12 kuukauden roadmap ja ensimmäiset toimenpiteet' },
	{ icon: 'check', text: 'AIvanTOn asiantuntijakatselmointi' },
];

const deliverables = [
	'Johdon 1-sivuinen tiivistelmä',
	'Muokattava Word-strategia',
	'Viimeistelty PDF-versio',
	'AI-kypsyys- ja riskihavainnot',
	'Käyttötapausten priorisointimatriisi',
	'Vaiheistettu etenemissuunnitelma',
	'Selkeä ehdotus jatkotoimista',
];

const steps = [
	{ n: 1, title: 'Rajaus', text: 'Tavoitteet ja vastaajat' },
	{ n: 2, title: 'Tiedonkeruu', text: 'Itsenäisesti tai työpajassa' },
	{ n: 3, title: 'Analyysi', text: 'AIvanTOn menetelmä ja agenttiprosessi' },
	{ n: 4, title: 'Katselmointi', text: 'Asiantuntija varmistaa laadun' },
	{ n: 5, title: 'Toimitus', text: 'Strategia, roadmap ja läpikäynti' },
];

const packages = [
	{
		name: 'Self-Service',
		audience: 'Pienet yritykset',
		price: '1 900 €',
		features: ['Ydinkysely', 'Analyysi', 'Strategiapohja', 'Kevyt katselmointi'],
	},
	{
		name: 'Workshop',
		audience: 'Pk-yritykset',
		price: '3 500 €',
		features: ['Ohjattu työpaja', 'Strategia', 'Roadmap', '1 h läpikäynti'],
		featured: true,
	},
	{
		name: 'Plus',
		audience: 'Suuremmat asiakkaat',
		price: '5 900 €',
		features: ['Useita vastaajaryhmiä', 'Osastokoonti', 'Priorisointityöpaja'],
	},
	{
		name: 'Enterprise',
		audience: 'Konsernit ja julkinen sektori',
		price: '8 900 €',
		from: true,
		features: ['Räätälöity laajuus', 'Useat yksiköt', 'Governance-painotus'],
	},
];

const icons: Record<string, string> = {
	survey: 'M9 4h6M9 4a2 2 0 0 0-2 2H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-1a2 2 0 0 0-2-2M8 11h8M8 15h5',
	gauge: 'M4 16a8 8 0 1 1 16 0M12 16l4-5M12 16h.01',
	target: 'M12 3a9 9 0 1 0 9 9M12 7a5 5 0 1 0 5 5M12 12l7-7M16 5h3v3',
	grid: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
	shield: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6zM9 12l2 2 4-4',
	route: 'M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM7 17h8a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h8',
	check: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 12l3 3 5-6',
};
---

<Layout
	title="AI Strategy Blueprint | AIvanTO Oy"
	description="AI Strategy Blueprint – valmis tekoälystrategian pohja nopeasti ja hallitusti. Kypsyysanalyysi, priorisoidut käyttötapaukset, governance ja 12 kuukauden roadmap."
>
	<header class="site-header">
		<div class="container header-inner">
			<a href="#top" class="brand" aria-label="AIvanTO – etusivulle">
				<img src={logoSrc} alt="AIvanTO" width="3896" height="1088" />
			</a>
			<nav aria-label="Päävalikko">
				<ul>
					<li><a href="#miksi">Miksi</a></li>
					<li><a href="#sisalto">Sisältö</a></li>
					<li><a href="#prosessi">Prosessi</a></li>
					<li><a href="#paketit">Paketit</a></li>
				</ul>
			</nav>
			<a href="#yhteys" class="btn btn-primary header-cta">Ota yhteyttä</a>
		</div>
	</header>

	<main id="top">
		<!-- HERO -->
		<section class="hero">
			<div class="container hero-grid">
				<div class="hero-copy">
					<span class="eyebrow">AIvanTO • Tekoälystrategia</span>
					<h1>AI Strategy <span>Blueprint</span></h1>
					<p class="hero-sub">Valmis tekoälystrategian pohja nopeasti ja hallitusti.</p>
					<p class="lead">
						Kokoamme organisaatiosi tekoälyn suunnan, prioriteetit, pelisäännöt ja etenemissuunnitelman yhdeksi
						johdon käyttöön soveltuvaksi kokonaisuudeksi.
					</p>
					<div class="hero-actions">
						<a href="#paketit" class="btn btn-primary">Tutustu paketteihin <span aria-hidden="true">→</span></a>
						<a href="#prosessi" class="btn btn-secondary">Näin palvelu etenee</a>
					</div>
					<ul class="hero-facts">
						<li><strong>12 kk</strong><span>roadmap</span></li>
						<li><strong>5</strong><span>vaihetta</span></li>
						<li><strong>alk. 1 900 €</strong><span>alv 0 %</span></li>
					</ul>
				</div>
				<div class="hero-art">
					<HeroVisual />
				</div>
			</div>
			<Crack class="hero-crack" />
		</section>

		<!-- MIKSI -->
		<section id="miksi" class="section">
			<div class="container">
				<div class="split">
					<div>
						<span class="eyebrow">Miksi palvelu?</span>
						<h2>Tekoälyä käytetään jo – mutta mihin suuntaan?</h2>
						<p class="lead">
							Monessa organisaatiossa tekoälyä hyödynnetään jo arjessa, mutta yhteinen suunta, prioriteetit,
							pelisäännöt ja etenemissuunnitelma puuttuvat. AI Strategy Blueprint kokoaa nämä yhdeksi johdon
							käyttöön soveltuvaksi kokonaisuudeksi.
						</p>
					</div>
					<div class="gap-grid">
						{
							gaps.map((g, i) => (
								<article class="gap-card">
									<span class="gap-num">0{i + 1}</span>
									<h3>{g.title}</h3>
									<p>{g.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- SISÄLTÖ -->
		<section id="sisalto" class="section section-alt">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Sisältö ja tuotokset</span>
					<h2>Mitä palvelu sisältää ja mitä saat</h2>
				</div>
				<div class="two-col">
					<div class="panel">
						<h3>Palvelu sisältää</h3>
						<ul class="icon-list">
							{
								includes.map((item) => (
									<li>
										<span class="icon" aria-hidden="true">
											<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
												<path d={icons[item.icon]} />
											</svg>
										</span>
										{item.text}
									</li>
								))
							}
						</ul>
					</div>
					<div class="panel panel-dark">
						<h3>Asiakas saa</h3>
						<ul class="deliv-list">
							{deliverables.map((d) => <li>{d}</li>)}
						</ul>
						<div class="formats" aria-label="Toimitusmuodot">
							<span class="format">1-sivu</span>
							<span class="format">Word</span>
							<span class="format">PDF</span>
						</div>
					</div>
				</div>

				<!-- Esimerkkivisualisoinnit -->
				<div class="showcase">
					<figure class="viz-card">
						<svg viewBox="0 0 360 280" role="img" aria-labelledby="mx-t">
							<title id="mx-t">Esimerkki käyttötapausten priorisointimatriisista: arvo pystyakselilla, toteutettavuus vaaka-akselilla</title>
							<rect x="50" y="20" width="290" height="210" fill="#ffffff" stroke="#dcd3c4"></rect>
							<rect x="195" y="20" width="145" height="105" fill="#f6e4d4"></rect>
							<line x1="195" y1="20" x2="195" y2="230" stroke="#dcd3c4" stroke-dasharray="4 4"></line>
							<line x1="50" y1="125" x2="340" y2="125" stroke="#dcd3c4" stroke-dasharray="4 4"></line>
							<g font-family="Inter, sans-serif" font-size="11" font-weight="600">
								<text x="268" y="40" text-anchor="middle" fill="#a8531d">ALOITA NÄISTÄ</text>
								<text x="122" y="40" text-anchor="middle" fill="#4a5d70">STRATEGISET</text>
								<text x="268" y="220" text-anchor="middle" fill="#4a5d70">NOPEAT VOITOT</text>
								<text x="122" y="220" text-anchor="middle" fill="#4a5d70">MYÖHEMMIN</text>
							</g>
							<circle cx="280" cy="70" r="13" fill="#c8733a"></circle>
							<circle cx="235" cy="95" r="9" fill="#c8733a"></circle>
							<circle cx="315" cy="100" r="7" fill="#c8733a"></circle>
							<circle cx="120" cy="80" r="10" fill="#2f6a8f"></circle>
							<circle cx="250" cy="170" r="8" fill="#2f6a8f"></circle>
							<circle cx="100" cy="180" r="6" fill="#2f6a8f" fill-opacity="0.5"></circle>
							<g font-family="Inter, sans-serif" font-size="11" fill="#13263b">
								<text x="195" y="252" text-anchor="middle">Toteutettavuus →</text>
								<text x="22" y="125" text-anchor="middle" transform="rotate(-90 22 125)">Liiketoiminta-arvo →</text>
							</g>
						</svg>
						<figcaption><strong>Priorisointimatriisi.</strong> Käyttötapaukset asemoidaan arvon ja toteutettavuuden mukaan.</figcaption>
					</figure>

					<figure class="viz-card">
						<svg viewBox="0 0 360 280" role="img" aria-labelledby="rm-t">
							<title id="rm-t">Esimerkki 12 kuukauden vaiheistetusta roadmapista neljällä vaiheella</title>
							<g font-family="Inter, sans-serif" font-size="11" fill="#4a5d70" font-weight="600">
								<text x="40" y="34">0–3 kk</text>
								<text x="120" y="34">3–6 kk</text>
								<text x="200" y="34">6–9 kk</text>
								<text x="280" y="34">9–12 kk</text>
							</g>
							<line x1="30" y1="46" x2="340" y2="46" stroke="#dcd3c4" stroke-width="2"></line>
							<g stroke="#dcd3c4" stroke-dasharray="3 4">
								<line x1="110" y1="46" x2="110" y2="250"></line>
								<line x1="190" y1="46" x2="190" y2="250"></line>
								<line x1="270" y1="46" x2="270" y2="250"></line>
							</g>
							<g font-family="Inter, sans-serif" font-size="11.5" font-weight="600">
								<rect x="32" y="64" width="150" height="34" rx="17" fill="#a8531d"></rect>
								<text x="46" y="85" fill="#ffffff">Pelisäännöt &amp; pilotit</text>
								<rect x="100" y="114" width="160" height="34" rx="17" fill="#2f6a8f"></rect>
								<text x="114" y="135" fill="#ffffff">Osaaminen &amp; data</text>
								<rect x="180" y="164" width="150" height="34" rx="17" fill="#0e2a47"></rect>
								<text x="194" y="185" fill="#ffffff">Skaalaus tuotantoon</text>
								<rect x="250" y="214" width="90" height="34" rx="17" fill="#dce8f0"></rect>
								<text x="262" y="235" fill="#0e2a47">Arviointi</text>
							</g>
						</svg>
						<figcaption><strong>Vaiheistettu roadmap.</strong> Ensimmäiset toimenpiteet ja 12 kuukauden eteneminen.</figcaption>
					</figure>
				</div>
				<p class="viz-note">Kuvat ovat havainnollistavia esimerkkejä – toimitettava sisältö laaditaan organisaatiosi vastausten perusteella.</p>
			</div>
		</section>

		<!-- PROSESSI -->
		<section id="prosessi" class="section">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Näin palvelu etenee</span>
					<h2>Viisi selkeää vaihetta rajauksesta toimitukseen</h2>
				</div>
				<ol class="steps">
					{
						steps.map((s) => (
							<li class="step">
								<span class="step-num">{s.n}</span>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- PAKETIT -->
		<section id="paketit" class="section section-alt">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Palvelupaketit</span>
					<h2>Valitse organisaatiollesi sopiva laajuus</h2>
					<p class="lead">Kaikki hinnat alv 0 %.</p>
				</div>
				<div class="pricing">
					{
						packages.map((p) => (
							<article class:list={['price-card', { featured: p.featured }]}>
								{p.featured && <span class="badge">Suositeltu</span>}
								<h3>{p.name}</h3>
								<p class="audience">{p.audience}</p>
								<p class="price">
									{p.from && <span class="from">alkaen</span>}
									{p.price}
								</p>
								<ul>
									{p.features.map((f) => <li>{f}</li>)}
								</ul>
								<a
									href={`mailto:${contact.email}?subject=${encodeURIComponent('AI Strategy Blueprint – ' + p.name)}`}
									class:list={['btn', p.featured ? 'btn-primary' : 'btn-secondary']}
								>
									Kysy lisää
								</a>
							</article>
						))
					}
				</div>

				<aside class="recommend">
					<div>
						<span class="eyebrow">Suositeltu pääpaketti</span>
						<h3>Blueprint Workshop – 3 500 €</h3>
						<p>
							Selvästi laajaa AI-strategiaprojektia kevyempi ja edullisempi, mutta riittävän valmis päätöksenteon,
							priorisoinnin ja seuraavien investointien pohjaksi.
						</p>
					</div>
					<a href="#yhteys" class="btn btn-light">Varaa keskustelu</a>
				</aside>
			</div>
		</section>

		<!-- YHTEYS -->
		<section id="yhteys" class="section contact">
			<div class="container contact-grid">
				<div>
					<span class="eyebrow eyebrow-light">Ota yhteyttä</span>
					<h2>Aloitetaan tekoälystrategiasi rakentaminen</h2>
					<p class="contact-lead">
						Kerro organisaatiosi tilanteesta, niin ehdotamme sopivan paketin ja aikataulun.
					</p>
				</div>
				<div class="contact-card">
					<p class="contact-name">Marko Määttä<span>{contact.company}</span></p>
					<a class="contact-line" href={`mailto:${contact.email}`}>
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6"></path></svg>
						{contact.email}
					</a>
					<a class="contact-line" href={`tel:${contact.phoneHref}`}>
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"></path></svg>
						{contact.phone}
					</a>
					<a href={`mailto:${contact.email}?subject=${encodeURIComponent('AI Strategy Blueprint')}`} class="btn btn-primary">Lähetä viesti</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<Crack />
		<div class="container footer-inner">
			<img src={logoSrc} alt="AIvanTO" class="footer-logo" width="3896" height="1088" loading="lazy" />
			<p>{contact.company} • Y-tunnus {contact.businessId}</p>
			<p>© {new Date().getFullYear()} {contact.company}</p>
		</div>
	</footer>
</Layout>

<style>
	/* Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(247, 242, 234, 0.94);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		height: 76px;
	}
	.brand img {
		height: 48px;
		width: auto;
		mix-blend-mode: multiply; /* logon kermanvärinen tausta sulautuu sivun taustaan */
	}
	nav ul {
		display: flex;
		gap: 32px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		color: var(--navy);
		text-decoration: none;
		font-family: var(--font-head);
		font-weight: 600;
		font-size: 0.95rem;
		padding: 6px 0;
		border-bottom: 2px solid transparent;
	}
	nav a:hover {
		border-bottom-color: var(--orange);
	}
	.header-cta {
		padding: 10px 20px;
		font-size: 0.9rem;
	}

	/* Hero */
	.hero {
		position: relative;
		padding: 72px 0 0;
		background:
			radial-gradient(900px 400px at 85% 20%, rgba(47, 106, 143, 0.12), transparent 70%),
			radial-gradient(600px 300px at 10% 90%, rgba(200, 115, 58, 0.1), transparent 70%);
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 56px;
		align-items: center;
		padding-bottom: 56px;
	}
	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4.2rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		margin-bottom: 12px;
	}
	.hero h1 span {
		color: var(--blue);
	}
	.hero-sub {
		font-family: var(--font-head);
		font-weight: 700;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		color: var(--orange-dark);
		margin-bottom: 16px;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin: 28px 0 36px;
	}
	.hero-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.hero-facts li {
		display: flex;
		flex-direction: column;
		border-left: 3px solid var(--orange);
		padding-left: 14px;
	}
	.hero-facts strong {
		font-family: var(--font-head);
		font-size: 1.35rem;
		color: var(--navy);
	}
	.hero-facts span {
		font-size: 0.9rem;
		color: var(--muted);
	}
	.hero-crack {
		display: block;
	}

	/* Miksi */
	.split {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 56px;
		align-items: start;
	}
	.gap-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px;
	}
	.gap-card {
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 24px;
		box-shadow: var(--shadow);
		border-top: 4px solid var(--blue);
	}
	.gap-card:nth-child(2),
	.gap-card:nth-child(3) {
		border-top-color: var(--orange);
	}
	.gap-card p {
		margin: 0;
		color: var(--muted);
		font-size: 0.97rem;
	}
	.gap-num {
		font-family: var(--font-head);
		font-weight: 800;
		color: var(--blue);
		font-size: 0.85rem;
		letter-spacing: 0.08em;
	}

	/* Sisältö */
	.section-alt {
		background: var(--cream-2);
	}
	.section-head {
		margin-bottom: 44px;
	}
	.two-col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
	}
	.panel {
		background: var(--white);
		border-radius: var(--radius);
		padding: 36px;
		box-shadow: var(--shadow);
	}
	.panel-dark {
		background: var(--navy);
		color: #e8eff5;
	}
	.panel-dark h3 {
		color: var(--white);
	}
	.icon-list,
	.deliv-list {
		list-style: none;
		padding: 0;
		margin: 16px 0 0;
		display: grid;
		gap: 14px;
	}
	.icon-list li {
