---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import JourneySteps from '../../components/JourneySteps.astro';
import PriceTable from '../../components/PriceTable.astro';
import { contactPage, getServices } from '../../lib/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = await getServices();
---

<Layout
	title="Palvelut ja hinnat | AIvanTO Oy"
	description="AIvanTOn palvelut AI-lähtöpisteestä tiekarttaan, tekoälyvaatimuksiin, käytännön toteutuksiin ja osaamisen kehittämiseen. Rajatut palvelut kiinteillä tai porrastetuilla hinnoilla."
>
	<Header />

	<main>
		<section class="page-hero">
			<div class="container">
				<a href={`${base}/`} class="back">← Takaisin etusivulle</a>
				<span class="eyebrow eyebrow-light">Palvelut</span>
				<h1>Palvelut ja hinnat</h1>
				<p class="lead-light">
					AIvanTO:n palvelut muodostavat selkeän polun: AI-lähtöpisteestä tiekarttaan, vaatimusten huomioimiseen,
					käytännön toteutuksiin ja osaamisen kehittämiseen. Jokainen palvelu on rajattu, kiinteästi tai porrastetusti
					hinnoiteltu ja tuottaa konkreettisen lopputuloksen.
				</p>
			</div>
		</section>

		<section class="cards-section">
			<div class="container">
				<ServiceGrid services={services} />
			</div>
		</section>

		<section id="miten-etenemme" class="section">
			<div class="container">
				<div class="section-head">
					<h2>Miten etenemme</h2>
					<p class="lead">Lähtöpisteestä tuloksiin, askel kerrallaan.</p>
				</div>
				<JourneySteps services={services} />
			</div>
		</section>

		<section id="hinnat" class="section section-alt">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Hinnat</span>
					<h2>Hintataulukko</h2>
					<p class="lead">Kaikki hinnat alv 0 %.</p>
				</div>
				<PriceTable services={services} />
			</div>
		</section>

		<section class="cta-section">
			<div class="container">
				<div class="cta">
					<div>
						<h2>Kiinnostuitteko?</h2>
						<p>Kertokaa organisaationne tilanteesta, niin ehdotamme sopivan palvelun ja aikataulun.</p>
					</div>
					<a href={contactPage} class="btn btn-light">Ota yhteyttä <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.page-hero {
		background: var(--navy);
		color: #e8eff5;
		padding: 56px 0 120px;
	}
	.page-hero h1 {
		color: var(--white);
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 800;
	}
	.eyebrow-light {
		color: #f0b286;
	}
	.back {
		display: table;
		color: #e8eff5;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		margin-bottom: 28px;
	}
	.back:hover {
		color: #f0b286;
	}
	.lead-light {
		font-size: 1.15rem;
		max-width: 760px;
		margin: 0;
	}
	.cards-section {
		margin-top: -64px;
	}
	.section-head {
		margin-bottom: 44px;
	}
	.section-alt {
		background: var(--cream-2);
	}
	.cta-section {
		padding: 96px 0;
	}
	.cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		background: linear-gradient(120deg, var(--navy), var(--navy-2) 60%, var(--blue));
		color: #e8eff5;
		border-radius: var(--radius);
		padding: 40px;
		box-shadow: var(--shadow);
	}
	.cta h2 {
		color: var(--white);
		font-size: 1.6rem;
	}
	.cta p {
		margin: 0;
	}
	.cta .btn {
		flex: none;
	}
	@media (max-width: 900px) {
		.cta {
			flex-direction: column;
			align-items: flex-start;
			padding: 28px;
		}
	}
	@media (max-width: 600px) {
		.page-hero {
			padding: 40px 0 96px;
		}
		.cta-section {
			padding: 64px 0;
		}
	}
</style>
