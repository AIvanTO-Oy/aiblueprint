---
// Hero-kuvitus: blueprint-arkki, jossa kypsyysarvio, priorisointimatriisi ja roadmap.
// Arkki nousee logon halkeamasta (brändikuvan värillinen versio).
import Crack from './Crack.astro';
import { crackPolygon } from '../lib/brand';
---

<div class="hero-visual-wrap">

<svg class="hero-visual" viewBox="0 0 520 460" role="img" aria-labelledby="hv-title">
	<title id="hv-title">Kuvitus: AI-tiekartta, jossa kypsyysarvio, priorisointimatriisi ja 12 kuukauden etenemissuunnitelma</title>
	<defs>
		<pattern id="hv-grid" width="20" height="20" patternUnits="userSpaceOnUse">
			<path d="M20 0 L0 0 0 20" fill="none" stroke="#3a5a85" stroke-opacity="0.35" stroke-width="0.6"></path>
		</pattern>
		<linearGradient id="hv-sheet" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#243f66"></stop>
			<stop offset="1" stop-color="#1c3453"></stop>
		</linearGradient>
		<clipPath id="hv-rise">
			<rect x="0" y="-20" width="520" height="440"></rect>
		</clipPath>
	</defs>

	<g clip-path="url(#hv-rise)">

	<!-- Takimmainen arkki -->
	<rect x="70" y="10" width="400" height="420" rx="16" fill="#f2f4f7" stroke="#dde2e9" transform="rotate(4 270 220)"></rect>

	<!-- Blueprint-arkki -->
	<rect x="40" y="24" width="420" height="410" rx="16" fill="url(#hv-sheet)"></rect>
	<rect x="40" y="24" width="420" height="410" rx="16" fill="url(#hv-grid)"></rect>

	<!-- Otsikkorivi -->
	<text x="66" y="62" fill="#ffffff" font-family="Montserrat, sans-serif" font-weight="800" font-size="16" letter-spacing="1">AI-TIEKARTTA</text>
	<polygon points={crackPolygon} fill="#c8764b" transform="translate(66 71) scale(0.0645)"></polygon>

	<!-- Kypsyys -->
	<text x="66" y="108" fill="#e3e8ef" font-family="Inter, sans-serif" font-size="11" font-weight="600">AI-KYPSYYS</text>
	<g font-family="Inter, sans-serif" font-size="10" fill="#e3e8ef">
		<text x="66" y="130">Data</text>
		<rect x="132" y="121" width="128" height="10" rx="5" fill="#ffffff" fill-opacity="0.12"></rect>
		<rect x="132" y="121" width="98" height="10" rx="5" fill="#8aa3c2"></rect>
		<text x="66" y="152">Osaaminen</text>
		<rect x="132" y="143" width="128" height="10" rx="5" fill="#ffffff" fill-opacity="0.12"></rect>
		<rect x="132" y="143" width="62" height="10" rx="5" fill="#8aa3c2"></rect>
		<text x="66" y="174">Governance</text>
		<rect x="132" y="165" width="128" height="10" rx="5" fill="#ffffff" fill-opacity="0.12"></rect>
		<rect x="132" y="165" width="40" height="10" rx="5" fill="#e79664"></rect>
		<text x="66" y="196">Käyttö</text>
		<rect x="132" y="187" width="128" height="10" rx="5" fill="#ffffff" fill-opacity="0.12"></rect>
		<rect x="132" y="187" width="112" height="10" rx="5" fill="#8aa3c2"></rect>
	</g>

	<!-- Matriisi -->
	<text x="296" y="108" fill="#e3e8ef" font-family="Inter, sans-serif" font-size="11" font-weight="600">PRIORISOINTI</text>
	<g transform="translate(296 118)">
		<rect width="138" height="96" fill="none" stroke="#e3e8ef" stroke-opacity="0.5"></rect>
		<line x1="69" y1="0" x2="69" y2="96" stroke="#e3e8ef" stroke-opacity="0.3" stroke-dasharray="3 3"></line>
		<line x1="0" y1="48" x2="138" y2="48" stroke="#e3e8ef" stroke-opacity="0.3" stroke-dasharray="3 3"></line>
		<rect x="69" y="0" width="69" height="48" fill="#c8764b" fill-opacity="0.18"></rect>
		<circle cx="100" cy="18" r="7" fill="#e79664"></circle>
		<circle cx="118" cy="34" r="5" fill="#e79664"></circle>
		<circle cx="84" cy="30" r="4" fill="#e79664"></circle>
		<circle cx="40" cy="22" r="5" fill="#8aa3c2"></circle>
		<circle cx="96" cy="70" r="6" fill="#8aa3c2"></circle>
		<circle cx="28" cy="74" r="4" fill="#8aa3c2" fill-opacity="0.6"></circle>
	</g>

	<!-- Roadmap -->
	<text x="66" y="250" fill="#e3e8ef" font-family="Inter, sans-serif" font-size="11" font-weight="600">12 KK ROADMAP</text>
	<g font-family="Inter, sans-serif" font-size="9" fill="#e3e8ef">
		<line x1="66" y1="272" x2="434" y2="272" stroke="#e3e8ef" stroke-opacity="0.35"></line>
		<text x="66" y="266">Q1</text><text x="158" y="266">Q2</text><text x="250" y="266">Q3</text><text x="342" y="266">Q4</text>
		<rect x="66" y="284" width="120" height="16" rx="8" fill="#c8764b"></rect>
		<rect x="140" y="310" width="150" height="16" rx="8" fill="#8aa3c2"></rect>
		<rect x="240" y="336" width="130" height="16" rx="8" fill="#3a5a85" stroke="#8aa3c2"></rect>
		<rect x="320" y="362" width="114" height="16" rx="8" fill="#ffffff" fill-opacity="0.2"></rect>
	</g>

	<!-- Tarkastusleima -->
	<g transform="translate(420 380)">
		<circle r="36" fill="#ffffff"></circle>
		<circle r="30" fill="none" stroke="#a0522f" stroke-width="2" stroke-dasharray="4 3"></circle>
		<path d="M-12 0 L-3 9 L14 -9" fill="none" stroke="#1c3453" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
	</g>
	</g>
</svg>
	<Crack variant="color" class="hv-crack" />
</div>

<style>
	.hero-visual {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 24px 40px rgba(28, 52, 83, 0.25));
	}
	/* Halkeaman yläreuna kohdistuu arkin leikattuun alareunaan: (460 − 420) / 520 leveydestä */
	.hero-visual-wrap :global(.hv-crack) {
		position: relative;
		margin-top: -7.7%;
	}
</style>
