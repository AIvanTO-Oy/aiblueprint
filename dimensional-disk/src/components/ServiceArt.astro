---
// Palvelukohtainen kuvitus palvelusivun yläosaan. Taka-arkki on logon fasettikiveä,
// otsikon alla logon halkeama kuparina.
import { crackPolygon, facets, rockShades } from '../lib/brand';
interface Props {
	slug: string;
	title: string;
}
const { slug, title } = Astro.props;
const id = `art-${slug}`;

const labels: Record<string, string> = {
	'ai-lahtopiste': 'VALMIUSARVIO',
	'ai-tiekartta': 'AI-TIEKARTTA',
	tekoalyvaatimukset: 'AI ACT',
	'digitaalinen-tyokaveri': 'TYÖKAVERI',
	'alykkaat-prosessit': 'PROSESSI',
	'ai-osaamispassi': 'AI-OSAAMISPASSI',
};

const rock = facets(300, 260, 6, 5, rockShades, slug.length * 31 + 3);

// EU-tähtikehä vaatimuskuvitukseen
const stars = Array.from({ length: 12 }, (_, k) => {
	const a = (k * Math.PI) / 6;
	return { x: 180 + 70 * Math.cos(a), y: 150 + 70 * Math.sin(a) };
});
---

<svg class="service-art" viewBox="0 0 360 300" role="img" aria-labelledby={id}>
	<title id={id}>Kuvitus: {title}</title>

	<!-- Arkit -->
	<defs>
		<clipPath id={`${id}-back`}>
			<rect width="300" height="260" rx="16"></rect>
		</clipPath>
	</defs>
	<g transform="translate(50 12) rotate(4 150 138)" clip-path={`url(#${id}-back)`}>
		{rock.map((f) => <polygon points={f.points} fill={f.fill} stroke={f.fill} stroke-width="0.6" />)}
		<rect width="300" height="5" fill="#c8764b"></rect>
	</g>
	<rect x="30" y="24" width="300" height="252" rx="16" fill="#ffffff"></rect>

	<text x="54" y="60" fill="#1c3453" font-family="Montserrat, sans-serif" font-weight="800" font-size="14" letter-spacing="1">{labels[slug]}</text>
	<polygon points={crackPolygon} fill="#c8764b" transform="translate(54 67) scale(0.0484)"></polygon>

	{
		slug === 'ai-lahtopiste' && (
			<g>
				<g fill="none" stroke-width="16">
					<path d="M118 150 A62 62 0 0 1 149 96.3" stroke="#a0522f" />
					<path d="M149 96.3 A62 62 0 0 1 211 96.3" stroke="#e79664" />
					<path d="M211 96.3 A62 62 0 0 1 242 150" stroke="#3a5a85" />
				</g>
				<line x1="180" y1="150" x2="216.8" y2="119.1" stroke="#1c3453" stroke-width="4" stroke-linecap="round" />
				<circle cx="180" cy="150" r="8" fill="#1c3453" />
				<g stroke-linecap="round" stroke-linejoin="round">
					<circle cx="66" cy="192" r="9" fill="#3a5a85" />
					<path d="M62 192 l3 3 l5 -6" stroke="#ffffff" stroke-width="2.4" fill="none" />
					<rect x="84" y="188" width="150" height="8" rx="4" fill="#e3e8ef" />
					<circle cx="66" cy="218" r="9" fill="#3a5a85" />
					<path d="M62 218 l3 3 l5 -6" stroke="#ffffff" stroke-width="2.4" fill="none" />
					<rect x="84" y="214" width="120" height="8" rx="4" fill="#e3e8ef" />
					<circle cx="66" cy="244" r="9" fill="#c8764b" />
					<path d="M66 239 v5 M66 248 v0.5" stroke="#ffffff" stroke-width="2.4" fill="none" />
					<rect x="84" y="240" width="170" height="8" rx="4" fill="#f7e6dc" />
				</g>
			</g>
		)
	}

	{
		slug === 'ai-tiekartta' && (
			<g>
				<g font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#4b5a6e">
					<text x="56" y="96">Q1</text>
					<text x="122" y="96">Q2</text>
					<text x="188" y="96">Q3</text>
					<text x="254" y="96">Q4</text>
				</g>
				<line x1="54" y1="106" x2="306" y2="106" stroke="#dde2e9" stroke-width="2" />
				<g stroke="#dde2e9" stroke-dasharray="3 4">
					<line x1="114" y1="106" x2="114" y2="256" />
					<line x1="180" y1="106" x2="180" y2="256" />
					<line x1="246" y1="106" x2="246" y2="256" />
				</g>
				<rect x="54" y="122" width="110" height="24" rx="12" fill="#a0522f" />
				<rect x="100" y="158" width="120" height="24" rx="12" fill="#3a5a85" />
				<rect x="170" y="194" width="110" height="24" rx="12" fill="#1c3453" />
				<rect x="236" y="230" width="70" height="24" rx="12" fill="#e3e8ef" />
			</g>
		)
	}

	{
		slug === 'tekoalyvaatimukset' && (
			<g>
				{stars.map((s) => <circle cx={s.x} cy={s.y} r="4.5" fill="#c8764b" />)}
				<path d="M180 106 l38 15 v27 c0 23 -16 39 -38 50 c-22 -11 -38 -27 -38 -50 v-27 z" fill="#1c3453" />
				<path d="M164 152 l11 11 l21 -22" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
				<rect x="64" y="244" width="72" height="12" rx="6" fill="#e3e8ef" />
				<rect x="144" y="244" width="72" height="12" rx="6" fill="#c8764b" />
				<rect x="224" y="244" width="72" height="12" rx="6" fill="#e3e8ef" />
			</g>
		)
	}

	{
		slug === 'digitaalinen-tyokaveri' && (
			<g>
				<line x1="80" y1="86" x2="80" y2="76" stroke="#1c3453" stroke-width="3" stroke-linecap="round" />
				<circle cx="80" cy="74" r="5" fill="#c8764b" />
				<rect x="54" y="86" width="52" height="52" rx="14" fill="#1c3453" />
				<circle cx="70" cy="110" r="5" fill="#eba27a" />
				<circle cx="90" cy="110" r="5" fill="#eba27a" />
				<rect x="70" y="122" width="20" height="4" rx="2" fill="#8aa3c2" />

				<rect x="118" y="88" width="188" height="42" rx="12" fill="#e3e8ef" />
				<rect x="132" y="100" width="124" height="6" rx="3" fill="#3a5a85" fill-opacity="0.55" />
				<rect x="132" y="113" width="90" height="6" rx="3" fill="#3a5a85" fill-opacity="0.55" />

				<rect x="158" y="140" width="148" height="32" rx="12" fill="#c8764b" />
				<rect x="172" y="153" width="110" height="6" rx="3" fill="#ffffff" fill-opacity="0.85" />

				<rect x="118" y="182" width="188" height="42" rx="12" fill="#e3e8ef" />
				<rect x="132" y="194" width="140" height="6" rx="3" fill="#3a5a85" fill-opacity="0.55" />
				<rect x="132" y="207" width="70" height="6" rx="3" fill="#3a5a85" fill-opacity="0.55" />

				<rect x="54" y="236" width="28" height="28" rx="8" fill="#3a5a85" />
				<rect x="90" y="236" width="28" height="28" rx="8" fill="#c8764b" />
				<rect x="126" y="236" width="28" height="28" rx="8" fill="#1c3453" />
				<rect x="162" y="236" width="28" height="28" rx="8" fill="#8aa3c2" />
				<rect x="198" y="236" width="28" height="28" rx="8" fill="#a0522f" />
			</g>
		)
	}

	{
		slug === 'alykkaat-prosessit' && (
			<g>
				<rect x="54" y="92" width="64" height="44" rx="10" fill="#e3e8ef" />
				<rect x="148" y="92" width="64" height="44" rx="10" fill="#c8764b" />
				<rect x="242" y="92" width="64" height="44" rx="10" fill="#e3e8ef" />
				<path d="M180 102 l3 9 9 3 -9 3 -3 9 -3 -9 -9 -3 9 -3 z" fill="#ffffff" />
				<g stroke="#1c3453" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M122 114 h20 M137 109 l5 5 -5 5" />
					<path d="M216 114 h20 M231 109 l5 5 -5 5" />
				</g>
				<line x1="54" y1="256" x2="306" y2="256" stroke="#dde2e9" stroke-width="2" />
				<rect x="64" y="222" width="50" height="34" rx="6" fill="#8aa3c2" />
				<rect x="130" y="198" width="50" height="58" rx="6" fill="#3a5a85" />
				<rect x="196" y="172" width="50" height="84" rx="6" fill="#1c3453" />
				<rect x="262" y="160" width="38" height="96" rx="6" fill="none" stroke="#c8764b" stroke-width="2" stroke-dasharray="5 4" />
			</g>
		)
	}

	{
		slug === 'ai-osaamispassi' && (
			<g>
				<rect x="54" y="86" width="150" height="10" rx="5" fill="#1c3453" />
				<rect x="54" y="106" width="200" height="6" rx="3" fill="#e3e8ef" />
				<rect x="54" y="120" width="170" height="6" rx="3" fill="#e3e8ef" />
				<g font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#4b5a6e">
					<text x="54" y="155">Ajattelu</text>
					<text x="54" y="179">Tieto</text>
					<text x="54" y="203">Taito</text>
				</g>
				<rect x="120" y="147" width="130" height="8" rx="4" fill="#3a5a85" />
				<rect x="120" y="171" width="130" height="8" rx="4" fill="#3a5a85" />
				<rect x="120" y="195" width="130" height="8" rx="4" fill="#3a5a85" />
				<g stroke="#ffffff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="270" cy="151" r="8" fill="#3a5a85" stroke="none" />
					<path d="M266 151 l3 3 l5 -6" />
					<circle cx="270" cy="175" r="8" fill="#3a5a85" stroke="none" />
					<path d="M266 175 l3 3 l5 -6" />
					<circle cx="270" cy="199" r="8" fill="#3a5a85" stroke="none" />
					<path d="M266 199 l3 3 l5 -6" />
				</g>
				<path d="M54 246 c10 -14 20 10 30 -4 s20 8 34 -6" fill="none" stroke="#1c3453" stroke-width="2" stroke-linecap="round" />
				<rect x="54" y="254" width="120" height="3" rx="1.5" fill="#dde2e9" />
				<path d="M250 250 L242 286 L252 278 L258 288 L262 256 Z" fill="#a0522f" />
				<path d="M274 250 L282 286 L272 278 L266 288 L262 256 Z" fill="#a0522f" />
				<circle cx="262" cy="238" r="26" fill="#c8764b" />
				<circle cx="262" cy="238" r="19" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="3 3" />
				<path d="M252 238 l7 7 l12 -13" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
			</g>
		)
	}
</svg>

<style>
	.service-art {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.3));
	}
</style>
