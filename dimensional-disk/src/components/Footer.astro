---
import Crack from './Crack.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const company = 'AIvanTO Oy';
const businessId = '3610409-8';
---

<footer class="site-footer">
	<div class="container">
		<Crack variant="white" class="footer-crack" />
	</div>
	<div class="container footer-inner">
		<img src={`${base}/aivanto-logo-white.png`} alt="AIvanTO" class="footer-logo" width="1003" height="254" loading="lazy" />
		<p>{company} • Y-tunnus {businessId}</p>
		<p class="footer-links">
			<a href={`${base}/palvelut/`}>Palvelut</a>
			<a href={`${base}/meista/`}>Keitä olemme</a>
			<a href={`${base}/tietosuoja/`}>Tietosuojaseloste</a>
		</p>
		<p>© {new Date().getFullYear()} {company}</p>
	</div>
</footer>

<style>
	/* Valkoinen logo mustalla pohjalla */
	.site-footer {
		background: var(--facets-dark) center / 480px auto, var(--black);
		color: var(--on-dark);
		padding: 0 0 40px;
	}
	.footer-crack {
		opacity: 0.9;
		margin-bottom: 28px;
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		color: #b9c2ce;
		font-size: 0.92rem;
	}
	.footer-inner p {
		margin: 0;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}
	.footer-inner a {
		color: var(--white);
		font-weight: 600;
	}
	.footer-inner a:hover {
		color: var(--on-dark-accent);
	}
	.footer-logo {
		height: 48px;
		width: auto;
	}
</style>
