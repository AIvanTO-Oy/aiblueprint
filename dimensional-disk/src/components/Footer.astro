---
import Crack from './Crack.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const company = 'AIvanTO Oy';
const businessId = '3610409-8';
---

<footer class="site-footer">
	<Crack />
	<div class="container footer-inner">
		<img src={`${base}/aivanto-logo.jpg`} alt="AIvanTO" class="footer-logo" width="3896" height="1088" loading="lazy" />
		<p>{company} • Y-tunnus {businessId}</p>
		<p class="footer-links">
			<a href={`${base}/meista/`}>Keitä olemme</a>
			<a href={`${base}/tietosuoja/`}>Tietosuojaseloste</a>
		</p>
		<p>© {new Date().getFullYear()} {company}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--cream);
		padding: 24px 0 40px;
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.footer-inner p {
		margin: 0;
	}
	.footer-links {
		display: flex;
		gap: 20px;
	}
	.footer-inner a {
		color: var(--navy);
		font-weight: 600;
	}
	.footer-inner a:hover {
		color: var(--orange-dark);
	}
	.footer-logo {
		height: 56px;
		width: auto;
		mix-blend-mode: multiply;
	}
</style>
