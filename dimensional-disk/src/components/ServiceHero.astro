---
import ServiceArt from './ServiceArt.astro';

interface Props {
	slug: string;
	title: string;
	subtitle: string;
	badge?: string;
}
const { slug, title, subtitle, badge } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="service-hero surface-dark">
	<div class="container hero-grid">
		<div>
			<a href={`${base}/palvelut/`} class="back">← Kaikki palvelut</a>
			<div class="tags">
				<span class="eyebrow eyebrow-light">Palvelu</span>
				{badge && <span class="badge">{badge}</span>}
			</div>
			<h1>{title}</h1>
			<p class="lead-light">{subtitle}</p>
		</div>
		<div class="hero-art">
			<ServiceArt slug={slug} title={title} />
		</div>
	</div>
</section>

<style>
	.service-hero {
		padding: 56px 0 64px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		align-items: center;
	}
	.hero-grid > * {
		min-width: 0;
	}
	.back {
		display: table;
		color: #e9edf2;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		margin-bottom: 28px;
	}
	.back:hover {
		color: #eba27a;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-bottom: 12px;
	}
	.tags .eyebrow {
		margin: 0;
	}
	.eyebrow-light {
		color: #eba27a;
	}
	.badge {
		background: var(--orange-dark);
		color: var(--white);
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 4px 12px;
		border-radius: 999px;
	}
	h1 {
		color: var(--white);
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.lead-light {
		font-family: var(--font-head);
		font-weight: 600;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		color: #eba27a;
		max-width: 560px;
		margin: 0;
	}
	.hero-art {
		max-width: 420px;
		justify-self: end;
		width: 100%;
	}
	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.hero-art {
			justify-self: start;
			max-width: 360px;
		}
	}
	@media (max-width: 600px) {
		.service-hero {
			padding: 40px 0 48px;
		}
	}
</style>
