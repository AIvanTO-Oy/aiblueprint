---
// Logon "halkeama" koristeellisena erottimena ja kuvituksena.
// color = värilogon kuparipinta ja fasettikivi, white = valkoinen mustalla pohjalla,
// black = musta valkoisella pohjalla.
import { CRACK_H, CRACK_W, copper, crackPolygon, facets, rockShades } from '../lib/brand';

interface Props {
	variant?: 'color' | 'white' | 'black';
	class?: string;
}
const { variant = 'color', class: className = '' } = Astro.props;
const id = `crack-${Math.random().toString(36).slice(2, 9)}`;
const rock = variant === 'color' ? facets(CRACK_W, CRACK_H, 46, 4, rockShades, 11) : [];
---

<svg class={`crack crack-${variant} ${className}`} viewBox={`0 0 ${CRACK_W} ${CRACK_H}`} aria-hidden="true">
	{
		variant === 'color' ? (
			<>
				<defs>
					<clipPath id={`${id}-clip`}>
						<polygon points={crackPolygon} />
					</clipPath>
					<linearGradient id={`${id}-cu`} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color={copper.light} />
						<stop offset="0.55" stop-color={copper.base} />
						<stop offset="1" stop-color={copper.dark} />
					</linearGradient>
				</defs>
				<g clip-path={`url(#${id}-clip)`}>
					{rock.map((f) => <polygon points={f.points} fill={f.fill} stroke={f.fill} stroke-width="0.6" />)}
					<rect x="0" y="0" width={CRACK_W} height="16" fill={`url(#${id}-cu)`} />
					<rect x="0" y="0" width={CRACK_W} height="2" fill="#f3b48d" />
				</g>
			</>
		) : (
			<polygon points={crackPolygon} fill={variant === 'white' ? '#ffffff' : '#0a0b0d'} />
		)
	}
</svg>

<style>
	.crack {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
